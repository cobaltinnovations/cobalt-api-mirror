{{#partial "preheader"}}
	Reset your {{platformName}} password.
{{/partial}}

{{#partial "content"}}
	<table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation">
		<tr>
			<td align="left" style="font-family:'SF Pro Display', 'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:28px; line-height:36px; font-weight:700; color:{{colors.n900}};">
				Reset your password
			</td>
		</tr>
		<tr>
			<td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td>
		</tr>
		<tr>
			<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:16px; line-height:24px; color:{{colors.n900}};">
				We received a request to reset your {{platformName}} password for
				<a href="mailto:{{recipientEmailAddress}}" style="color:{{colors.p500}}; text-decoration:underline;">{{recipientEmailAddress}}</a>.
				Click the button below to reset your password:
			</td>
		</tr>
		<tr>
			<td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td>
		</tr>
		<tr>
			<td align="left">
				<table border="0" cellspacing="0" cellpadding="0" role="presentation">
					<tr>
						<td align="center" bgcolor="{{colors.p500}}" style="background-color:{{colors.p500}}; border-radius:999px;">
							<a href="{{{passwordResetLink}}}" target="_blank" style="display:inline-block; font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:14px; line-height:20px; font-weight:600; color:#FFFFFF; text-decoration:none; padding:11px 21px; border-radius:999px;">
								Reset password
							</a>
						</td>
					</tr>
				</table>
			</td>
		</tr>
		<tr>
			<td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td>
		</tr>
		<tr>
			<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:16px; line-height:24px; color:{{colors.n900}};">
				If you did not request a password reset, or if it was requested by mistake, you can disregard this message.
			</td>
		</tr>
		<tr>
			<td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td>
		</tr>
		<tr>
			<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:16px; line-height:24px; color:{{colors.n900}};">
				Thank you,<br />
				Team {{platformName}}
			</td>
		</tr>
		<tr>
			<td height="16" style="height:16px; line-height:16px; font-size:1px;">&nbsp;</td>
		</tr>
	</table>
{{/partial}}

{{#partial "footer"}}
	You are receiving this email because {{recipientEmailAddress}} has an active {{platformName}} account which may be affected by this information. You cannot unsubscribe from this transactional email, but this does not affect your existing marketing communication preferences.
{{/partial}}

{{> layouts/en/v2}}
